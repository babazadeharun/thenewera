@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap');
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#02040a;color:#f5f6ff;font-family:Manrope,Arial,sans-serif}a{text-decoration:none;color:inherit}.container{width:min(1024px,calc(100% - 56px));margin:auto}.nav{height:50px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.055);position:relative;z-index:30}.brand{display:flex;align-items:center;gap:8px;font:700 17px 'Space Grotesk';letter-spacing:.14em;white-space:nowrap}.brandMark{font-size:25px;color:#8b61ff;text-shadow:0 0 15px #6e4bff}.navLinks{display:flex;gap:25px;color:#b5b8c6;font-size:9px}.navLinks a{height:50px;display:flex;align-items:center;position:relative}.navLinks a:hover,.navLinks a.active{color:#fff}.navLinks a.active:after{content:'';position:absolute;left:0;right:0;bottom:0;height:2px;background:#915cff;box-shadow:0 0 9px #8751ff}.navActions{display:flex;align-items:center;gap:14px;font-size:9px}.iconBtn{border:0;background:none;color:#dfe1ea;padding:0}.pill{background:linear-gradient(100deg,#7a4bff,#8e63ff 55%,#4c8cff);box-shadow:0 0 25px rgba(111,68,255,.3);border-radius:999px;padding:8px 15px;font-weight:800}.hero{min-height:420px;position:relative;overflow:hidden;border-bottom:1px solid rgba(255,255,255,.06);background:#02050b}.screenshotHero .heroArt{position:absolute;inset:0;background-image:url('/hero-space.jpg');background-position:center right;background-size:cover;opacity:.96}.screenshotHero .heroArt:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#02050b 0%,rgba(2,5,11,.94) 24%,rgba(2,5,11,.18) 56%,rgba(2,5,11,.04) 100%)}.stars{position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,.9) 0 1px,transparent 1.3px);background-size:95px 83px;opacity:.13}.heroInner{position:relative;z-index:5;padding-top:58px}.eyebrow{font-size:8px;letter-spacing:.3em;color:#a06eff;font-weight:800;margin-bottom:13px}.hero h1{font:700 43px/1.02 'Space Grotesk';letter-spacing:-.045em;margin:0;max-width:440px}.hero h1 span,h2 span{background:linear-gradient(100deg,#a05eff,#4ca6ff);-webkit-background-clip:text;background-clip:text;color:transparent}.hero p{color:#a4a8b8;line-height:1.55;max-width:395px;font-size:10px;margin:15px 0 20px}.heroCtas{display:flex;gap:10px;align-items:center}.primary{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(100deg,#7548ff,#6b8dff);box-shadow:0 0 24px rgba(113,70,255,.25);border-radius:999px;padding:10px 16px;font-size:10px;font-weight:800}.secondary{border:1px solid rgba(171,143,255,.45);padding:9px 16px;border-radius:999px;color:#e1e2eb;font-size:10px}.proof{display:flex;align-items:center;gap:10px;margin-top:24px}.avatars{display:flex}.avatars img{width:27px;height:27px;object-fit:cover;border-radius:50%;border:2px solid #080a11;margin-right:-7px}.proof strong,.proof small{display:block}.proof strong{font-size:9px}.proof small{font-size:8px;color:#7e8396;margin-top:2px}.scrollHint{position:absolute;right:50%;bottom:12px;color:#7c8192;font-size:7px;letter-spacing:.2em}.scrollHint span{margin-left:8px;color:#a06dff}.section{padding:55px 0}.servicesSection{position:relative}.sectionIntro{display:grid;grid-template-columns:1fr 310px;gap:45px;align-items:end;margin-bottom:25px}.sectionIntro h2,.finalCta h2{font:700 31px/1.05 'Space Grotesk';letter-spacing:-.04em;margin:0}.sectionIntro>p{color:#888d9e;line-height:1.6;font-size:10px;margin:0}.serviceGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.serviceCard{min-height:96px;border:1px solid rgba(105,113,155,.23);background:linear-gradient(145deg,rgba(11,14,27,.92),rgba(5,7,14,.95));border-radius:10px;padding:14px;transition:.2s;position:relative}.serviceCard:hover{transform:translateY(-2px);border-color:rgba(133,95,255,.5);box-shadow:0 10px 30px rgba(58,36,120,.16)}.serviceIcon{width:27px;height:27px;border-radius:8px;display:grid;place-items:center;color:#a276ff;background:rgba(112,72,255,.13);border:1px solid rgba(132,95,255,.35);margin-bottom:9px}.serviceCard h3{font-size:10px;margin:0 0 5px}.serviceCard p{font-size:8px;color:#7f8497;line-height:1.45;margin:0;max-width:130px}.outlineBtn{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(164,135,255,.45);border-radius:999px;padding:9px 14px;font-size:9px;margin-top:22px}.creatorsSection{padding-top:25px}.creatorIntro{grid-template-columns:1fr auto;align-items:end}.introCopy{max-width:420px!important;margin-top:10px!important}.filters{display:flex;gap:22px;align-items:center;color:#a2a5b4;font-size:9px;white-space:nowrap}.filters .selected{background:rgba(126,79,255,.2);border:1px solid rgba(129,90,255,.4);color:#d8d0ff;padding:6px 12px;border-radius:999px}.creatorGrid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.creatorCard{border:1px solid rgba(99,106,148,.28);background:#050811;border-radius:8px;overflow:hidden}.portrait{height:150px;position:relative;overflow:hidden;background:#090c16}.portrait img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(1.05)}.portrait:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 42%,rgba(2,4,9,.95) 100%)}.portraitBadge{position:absolute;right:9px;top:9px;z-index:2;width:17px;height:17px;border-radius:50%;border:1px solid rgba(175,147,255,.45);display:grid;place-items:center;font-size:7px;color:#c8b6ff;background:rgba(0,0,0,.25)}.creatorBody{padding:10px}.creatorHead{display:flex;justify-content:space-between;align-items:start}.creatorHead h3{font-size:10px;margin:0 0 3px}.creatorHead p{font-size:8px;color:#858a9c;margin:0}.creatorHead svg{color:#8991a5;margin-top:4px}.creatorMeta{display:flex;justify-content:space-between;align-items:center;margin:10px 0;color:#898e9f;font-size:7px}.creatorMeta span:first-child{display:flex;align-items:center;gap:3px;color:#c1c4d0}.creatorMeta svg{color:#f0c44f}.profileBtn{display:flex;justify-content:center;border:1px solid rgba(108,80,227,.55);border-radius:999px;padding:7px;font-size:8px}.howSection{padding:25px 0 55px}.howBox{min-height:120px;border:1px solid rgba(102,83,180,.35);border-radius:10px;overflow:hidden;background:radial-gradient(circle at 20% 100%,rgba(90,57,180,.28),transparent 38%),linear-gradient(110deg,#070a18,#050713);display:grid;grid-template-columns:1fr 1.45fr}.howVisual{padding:23px 35px;position:relative;overflow:hidden}.howArt{position:absolute;inset:0;background:url('/hero-space.jpg') left bottom/cover;opacity:.18}.howVisual>*:not(.howArt){position:relative}.howVisual h2{font:700 21px 'Space Grotesk';margin:0}.howVisual p{color:#858a9e;font-size:8px;margin:7px 0}.steps{display:grid;grid-template-columns:repeat(3,1fr);align-items:center;padding:20px;gap:15px;position:relative}.steps div{padding-left:15px;border-left:1px solid rgba(255,255,255,.1)}.steps b{display:grid;place-items:center;width:22px;height:22px;border-radius:7px;background:rgba(117,76,255,.14);border:1px solid rgba(132,94,255,.3);color:#ad8cff;font-size:10px;margin-bottom:12px}.steps span{display:block;font-weight:700;font-size:9px;margin-bottom:5px}.steps small{color:#777c91;font-size:7px}.stepArrow{position:absolute;right:15px;top:50%;transform:translateY(-50%);width:31px;height:31px;border:1px solid rgba(153,122,255,.5);border-radius:50%;display:grid;place-items:center;color:#b99cff}.finalCta{text-align:center;padding:65px 0 70px;position:relative}.finalCta h2{position:relative;font-size:38px}.finalCta p{position:relative;color:#858a9e;font-size:10px;margin:12px auto 20px;max-width:400px;line-height:1.7}.footer{border-top:1px solid rgba(255,255,255,.07);padding:18px 0 25px;display:flex;justify-content:space-between;align-items:center;color:#5e6376;font-size:8px}.footer .brand{font-size:11px}.footer .brandMark{font-size:17px}
@media(max-width:950px){.navLinks{display:none}.hero{min-height:560px}.heroInner{padding-top:75px}.hero h1{font-size:54px}.heroArt{background-position:60% center!important}.serviceGrid{grid-template-columns:repeat(2,1fr)}.creatorGrid{grid-template-columns:repeat(3,1fr)}.sectionIntro{grid-template-columns:1fr;gap:12px}.filters{flex-wrap:wrap}.howBox{grid-template-columns:1fr}.steps{padding:25px}}
@media(max-width:600px){.container{width:calc(100% - 28px)}.nav{height:58px}.navActions .login,.navActions .iconBtn{display:none}.brand{font-size:13px}.hero{min-height:620px}.heroInner{padding-top:80px}.hero h1{font-size:46px}.heroArt{background-position:62% center!important}.hero p{font-size:10px;max-width:290px}.heroCtas{flex-wrap:wrap}.section{padding:55px 0}.sectionIntro h2{font-size:30px}.serviceGrid,.creatorGrid{grid-template-columns:1fr 1fr}.creatorGrid{gap:8px}.portrait{height:145px}.creatorMeta{display:block;line-height:1.7}.creatorMeta span{display:block}.howBox{grid-template-columns:1fr}.steps{grid-template-columns:1fr;gap:18px}.stepArrow{display:none}.footer{flex-direction:column;gap:10px;align-items:flex-start}}
/* Inner pages retain the same visual language */
.innerPage{min-height:100vh;background:radial-gradient(circle at 80% 10%,rgba(86,47,190,.14),transparent 28%),#03040a;padding-bottom:80px}.innerHero{padding:60px 0 45px}.back{display:inline-flex;color:#8c91a6;font-size:10px;margin-bottom:35px}.back:hover{color:#fff}.innerHero h1{font:700 54px/1.02 'Space Grotesk';letter-spacing:-.05em;margin:0 0 16px}.innerHero h1 span,.formPage h1 span{background:linear-gradient(100deg,#a067ff,#5bbcff);-webkit-background-clip:text;background-clip:text;color:transparent}.innerHero>p{max-width:560px;color:#858a9e;line-height:1.8;font-size:10px}.serviceList{border-top:1px solid rgba(255,255,255,.08)}.serviceRow{display:grid;grid-template-columns:55px 1fr 40px;gap:20px;align-items:center;padding:25px 8px;border-bottom:1px solid rgba(255,255,255,.07)}.serviceNumber{color:#7654d5;font:600 9px 'Space Grotesk'}.serviceRow h2{font:600 22px 'Space Grotesk';margin:0 0 7px}.serviceRow p{margin:0;color:#777c91;font-size:10px}.tagLine{display:flex;gap:7px;margin-top:11px;flex-wrap:wrap}.tagLine span,.filterBar span{font-size:8px;color:#9ca1b5;border:1px solid rgba(255,255,255,.08);padding:5px 8px;border-radius:99px}.rowArrow{color:#8f67ff}.creatorGrid.large{grid-template-columns:repeat(3,1fr)}.profilePage{padding-top:45px}.profileHero{display:grid;grid-template-columns:320px 1fr;gap:50px;align-items:center;padding:20px 0 80px}.profilePortrait{height:360px;border-radius:20px}.profileHero h1{font:600 52px 'Space Grotesk';margin:0 0 5px}.profileHero h2{font:500 18px 'Space Grotesk';color:#9ea3b8}.profileHero p{color:#858a9e;line-height:1.8;font-size:10px}.portfolioBlock{padding-top:25px;border-top:1px solid rgba(255,255,255,.08)}.portfolioBlock h2{font:600 34px 'Space Grotesk'}.portfolioGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.portfolioTile{height:220px;border-radius:15px;border:1px solid rgba(255,255,255,.08);padding:16px;display:flex;flex-direction:column;justify-content:end;overflow:hidden;position:relative}.portfolioTile:before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 65% 25%,rgba(142,86,255,.55),transparent 28%),linear-gradient(145deg,#171a35,#070812)}.portfolioTile:after{content:'';position:absolute;width:130px;height:130px;border:1px solid rgba(255,255,255,.18);border-radius:50%;right:-35px;top:-25px}.portfolioTile span,.portfolioTile strong{position:relative;z-index:2}.portfolioTile span{font-size:7px;color:#9e72ff;letter-spacing:.2em}.portfolioTile strong{font:500 19px 'Space Grotesk';margin-top:6px}.formPage{max-width:760px;padding:45px 0}.formPage h1{font:600 52px/1.02 'Space Grotesk';letter-spacing:-.05em;margin:0 0 16px}.formPage>p{color:#858a9e;line-height:1.8;font-size:10px;max-width:650px;margin-bottom:35px}.projectForm{display:grid;gap:17px;border-top:1px solid rgba(255,255,255,.08);padding-top:25px}.projectForm label{display:grid;gap:8px;color:#c5c8d7;font-size:9px}.projectForm input,.projectForm select,.projectForm textarea{font:inherit;color:#e9eaff;background:#080a13;border:1px solid rgba(255,255,255,.1);border-radius:9px;padding:12px;outline:none}.formSplit{display:grid;grid-template-columns:1fr 1fr;gap:14px}.projectForm button{border:0;cursor:pointer;font-family:inherit}.successBox{border:1px solid rgba(127,92,255,.3);background:linear-gradient(145deg,rgba(18,14,40,.8),rgba(7,9,18,.9));border-radius:18px;padding:40px;text-align:center}.successBox h2{font:600 30px 'Space Grotesk'}
@media(max-width:950px){.creatorGrid.large{grid-template-columns:repeat(2,1fr)}.profileHero{grid-template-columns:1fr}.portfolioGrid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.innerHero h1,.formPage h1{font-size:43px}.creatorGrid.large,.portfolioGrid{grid-template-columns:1fr}.formSplit{grid-template-columns:1fr}}
