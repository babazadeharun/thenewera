/* Mobile only: place existing navigation in its own row, above page content. */
@media(max-width:760px){
  body .neSiteHeader,body:has(.servicesReference) .neSiteHeader{position:relative!important;height:auto!important;min-height:114px!important;overflow:visible;background:#f5f7f9!important;border-bottom:1px solid #dce5eb!important;box-shadow:0 3px 12px #455b6810!important;backdrop-filter:none!important}
  body .neSiteHeaderInner,body:has(.servicesReference) .neSiteHeaderInner{width:calc(100% - 36px)!important;height:auto!important;display:grid!important;grid-template-columns:minmax(0,1fr) auto;gap:0 12px!important;padding:16px 0 0!important;align-items:center}
  body .neSiteBrand,body:has(.servicesReference) .neSiteBrand{height:34px!important;min-width:0;flex:none!important;grid-column:1;grid-row:1}
  body .neSiteBrand img,body:has(.servicesReference) .neSiteBrand img{width:145px!important;height:25px!important;object-fit:cover!important;object-position:center!important;filter:brightness(0)!important}
  body .neSiteActions,body:has(.servicesReference) .neSiteActions{grid-column:2;grid-row:1;gap:9px!important;min-width:0;justify-content:flex-end}
  body .neSiteLogin,body:has(.servicesReference) .neSiteLogin{color:#263540!important;font-size:11px!important;white-space:nowrap}
  body .neSiteSignup,body:has(.servicesReference) .neSiteSignup{color:#263540!important;font-size:11px!important;background:#ffffffb3!important;border:1px solid #d5dfe5!important;border-radius:8px!important;padding:0 10px!important;min-height:36px!important;box-shadow:0 2px 5px #455b6810!important}
  body .neSiteNav,body:has(.servicesReference) .neSiteNav{display:flex!important;grid-column:1/-1;grid-row:2;width:100%!important;min-width:0;height:56px!important;overflow-x:auto!important;overflow-y:hidden!important;justify-content:flex-start!important;gap:23px!important;white-space:nowrap;scrollbar-width:thin;scrollbar-color:#bdcbd4 transparent;padding:0 1px!important;overscroll-behavior-x:contain}
  body .neSiteNav a,body:has(.servicesReference) .neSiteNav a{flex:none!important;height:49px!important;font-size:12px!important;font-weight:400!important;color:#32414e!important;display:flex;align-items:center;padding:0!important;margin:0!important;text-shadow:none!important}
  body:has(.servicesReference) .neSiteNav a[href='/#services']{border-bottom:2px solid #22cbd8!important;margin:0!important;padding:0!important}
  body .neSiteSearch,body .neSiteMenu{display:none!important}
  /* Homepage uses its existing separate navbar. Put it in document flow. */
  .glassHome .screenshotHero .nav{position:relative!important;top:auto!important;left:auto!important;right:auto!important;display:grid!important;grid-template-columns:minmax(0,1fr) auto;min-height:0!important;height:auto!important;padding:16px 0 0!important;gap:0 12px!important;background:#f5f7f9!important;z-index:30;border-radius:0!important;box-shadow:none!important}
  .glassHome .screenshotHero .nav .brand{grid-column:1;grid-row:1;min-width:0;height:35px}
  .glassHome .screenshotHero .nav .navActions{grid-column:2;grid-row:1;gap:12px!important;align-items:center}
  .glassHome .screenshotHero .nav .navLinks{grid-column:1/-1;grid-row:2;width:100%;display:flex!important;height:58px!important;align-items:center;justify-content:flex-start!important;overflow-x:auto!important;overflow-y:hidden;gap:25px!important;margin:0;padding:0!important;scrollbar-width:thin;white-space:nowrap}
  .glassHome .screenshotHero .nav .navLinks a{flex:none;height:44px!important;display:flex;align-items:center;font-size:12px!important}
  .glassHome .screenshotHero .heroInner{padding-top:37px!important}
  .glassHome .screenshotHero .glassMoreMenu{top:calc(100% + 5px);z-index:40}
  /* Separate Services text from decorative imagery on narrow screens. */
  body .servicesReference .innerHero{padding:74px 0 270px!important;min-height:0!important}
  body .servicesReference .innerHero .back{top:23px!important;left:0!important;font-size:12px!important}
  body .servicesReference .innerHero .eyebrow{margin-bottom:18px!important}
  body .servicesReference .innerHero h1{font-size:clamp(32px,8.8vw,42px)!important;max-width:100%!important;line-height:1.13!important;margin-bottom:20px!important}
  body .servicesReference .innerHero>p{font-size:16px!important;line-height:1.65!important;max-width:100%!important}
  body .servicesReference .innerHero:after{width:calc(100% + 36px)!important;height:245px!important;inset:auto -18px 0 auto!important;background-position:right center!important;background-size:auto 100%!important;opacity:1!important;mask-image:linear-gradient(180deg,transparent 0%,#000 15%);pointer-events:none}
  body .servicesReference .serviceList{margin-top:24px!important;gap:20px!important}
  body .servicesReference .serviceRow{padding:25px 24px 68px!important;min-height:380px!important}
  body .servicesReference .serviceNumber{margin-bottom:105px!important}
  body:has(.servicesReference) .servicesReference .serviceRow:before{width:160px!important;height:150px!important;top:6px!important;right:17px!important;opacity:1!important}
  body .servicesReference .serviceRow h2{font-size:29px!important;max-width:100%!important;line-height:1.18!important;margin-bottom:14px!important}
  body .servicesReference .serviceRow p{font-size:16px!important;max-width:100%!important;min-height:0!important;line-height:1.6!important}
  body .servicesReference .tagLine{margin-top:23px!important;padding-right:0!important;gap:8px!important}
  body .servicesReference .tagLine span{font-size:12px!important;padding:8px 12px!important}
  body .servicesReference .rowArrow{right:23px!important;bottom:18px!important}
  body .servicesReference .finalCta{padding:35px 26px 260px!important;min-height:0!important}
  body .servicesReference .finalCta h2{font-size:36px!important;line-height:1.15!important}
  body .servicesReference .finalCta p{font-size:16px!important;line-height:1.65!important;margin-bottom:24px!important}
  body .servicesReference .finalCta:before{inset:auto 0 0!important;height:240px!important;background-position:right bottom!important;background-size:auto 100%!important;background-repeat:no-repeat;opacity:1!important;mask-image:linear-gradient(180deg,transparent,#000 20%)}
}
@media(max-width:360px){body .neSiteBrand img,body:has(.servicesReference) .neSiteBrand img,.glassHome .screenshotHero .brand img{width:122px!important}body .neSiteActions{gap:6px!important}body .neSiteLogin,body .neSiteSignup{font-size:10px!important}.glassHome .screenshotHero .nav .navActions{gap:8px!important}.glassHome .glassMore summary{font-size:10px!important}.glassHome .screenshotHero .pill{font-size:10px!important;padding:9px 10px!important}body .servicesReference .serviceRow h2{font-size:26px!important}}
