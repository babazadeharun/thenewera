  updatedAt    DateTime     @updatedAt
  transactions FinanceTransaction[]
  payables     FinancePayable[]

  @@index([name])
  @@index([status])
}

model FinanceTransaction {
  id              String                    @id @default(cuid())
  date            DateTime
  amount          Decimal                   @db.Decimal(14, 2)
  type            FinanceTransactionType
  status          FinanceTransactionStatus  @default(POSTED)
  category        String
  description     String                    @db.Text
  accountId       String?
  toAccountId     String?
  clientId        String?
  vendorId        String?
  projectId       String?
  invoiceId       String?
  paymentMethod   PaymentMethod?
  reference       String?
  notes           String?                   @db.Text
  createdById     String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  account         FinanceAccount?           @relation("FinanceTransactionAccount", fields: [accountId], references: [id], onDelete: SetNull)
  toAccount       FinanceAccount?           @relation("FinanceTransactionToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  client          Client?                   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  vendor          Vendor?                   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  project         Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoice         Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy       User?                     @relation("FinanceTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date, type, status])
  @@index([accountId, date])
  @@index([toAccountId, date])
  @@index([clientId])
  @@index([vendorId])
  @@index([projectId])
  @@index([invoiceId])
}

model Invoice {
  id              String          @id @default(cuid())
  number          String          @unique
  clientId        String
  projectId       String?
  issueDate       DateTime
  dueDate         DateTime
  subtotal        Decimal         @db.Decimal(14, 2)
  tax             Decimal         @default(0) @db.Decimal(14, 2)
  discount        Decimal         @default(0) @db.Decimal(14, 2)
  total           Decimal         @db.Decimal(14, 2)
  paidAmount      Decimal         @default(0) @db.Decimal(14, 2)
  currency        String          @default("AZN")
  status          InvoiceStatus   @default(DRAFT)
  notes           String?         @db.Text
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy       User?           @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items           InvoiceItem[]
  payments        FinancePayment[]
  transactions    FinanceTransaction[]

  @@index([clientId, dueDate])
  @@index([projectId])
  @@index([status, dueDate])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  serviceName String?
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
