generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  ADMIN
  CREATOR
  SUPER_ADMIN
  EVENTS_ADMIN
  EVENTS_FINANCE
  PROMOTER
}

enum EventStatus {
  DRAFT
  APPLICATION_OPEN
  ACTIVE
  SOLD_OUT
  COMPLETED
  CANCELLED
}

enum PromoterStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
  INACTIVE
}

enum PromoterApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum PromoterEventStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  FACEBOOK
  YOUTUBE
  TELEGRAM
  OTHER
}

enum VerificationChannel {
  EMAIL
  PHONE
}

enum ProjectStatus {
  BRIEF_SUBMITTED
  REVIEWING
  APPROVED
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum MediaCategory {
  HERO
  CREATORS
  PORTFOLIO
  PORTFOLIO_VIDEO
  PORTFOLIO_DESIGN
  PARTNER_LOGO
  CLIENTS
  SERVICES
  BLOG
  GENERAL
}

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  phone        String?   @unique
  passwordHash String
  verifiedAt   DateTime?
  role         UserRole  @default(CLIENT)
  clientId     String?   @unique
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessions     Session[]
  verificationCodes VerificationCode[]
  promoter        Promoter?
  reviewedPromoterApplications PromoterApplication[] @relation("PromoterApplicationReviewer")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id          String    @id @default(cuid())
  email       String?   @unique
  phone       String?   @unique
  firstName   String
  lastName    String
  company     String?
  jobTitle    String?
  industry    String?
  companySize String?
  country     String?
  website     String?
  createdAt   DateTime  @default(now())
  projects    Project[]
  user        User?
}

model VerificationCode {
  id         String             @id @default(cuid())
  identifier String
  channel    VerificationChannel
  codeHash   String
  expiresAt  DateTime
  usedAt     DateTime?
  attempts   Int                @default(0)
  createdAt  DateTime           @default(now())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([identifier, channel, createdAt])
  @@index([userId, createdAt])
}

model SiteSetting {
  id        String   @id
  heroImage String?  @db.Text
  siteName             String?  @db.Text
  logoMediaId          String?
  faviconMediaId       String?
  seoTitle             String?  @db.Text
  seoDescription       String?  @db.Text
  socialImageMediaId   String?
  contactEmail         String?
  contactPhone         String?
  address              String?  @db.Text
  socialLinks          String?  @db.Text
  maintenanceMode      Boolean  @default(false)
  logoMedia            Media?   @relation("SiteLogoMedia", fields: [logoMediaId], references: [id], onDelete: SetNull)
  faviconMedia         Media?   @relation("SiteFaviconMedia", fields: [faviconMediaId], references: [id], onDelete: SetNull)
  socialImageMedia     Media?   @relation("SiteSocialImageMedia", fields: [socialImageMediaId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt
}

model Media {
  id           String        @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  url          String        @db.Text
  storageKey   String?
  category     MediaCategory @default(GENERAL)
  alt          String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  desktopHeros Hero[]        @relation("HeroDesktopMedia")
  mobileHeros  Hero[]        @relation("HeroMobileMedia")
  videoHeros   Hero[]        @relation("HeroVideoMedia")
  homepageSections HomepageSection[]
  siteLogos       SiteSetting[] @relation("SiteLogoMedia")
  siteFavicons    SiteSetting[] @relation("SiteFaviconMedia")
  siteSocialImages SiteSetting[] @relation("SiteSocialImageMedia")
  eventCoverMedia Event[] @relation("EventCoverMedia")
  eventGalleryMedia EventGalleryMedia[] @relation("EventGalleryMedia")

  @@index([category])
  @@index([createdAt])
}

model Hero {
  id            String   @id @default(cuid())
  title         String
  description   String?  @db.Text
  ctaText       String?
  ctaUrl        String?
  overlay       String?
  desktopMediaId String?
  mobileMediaId  String?
  videoMediaId   String?
  active        Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  desktopMedia Media?   @relation("HeroDesktopMedia", fields: [desktopMediaId], references: [id], onDelete: SetNull)
  mobileMedia  Media?   @relation("HeroMobileMedia", fields: [mobileMediaId], references: [id], onDelete: SetNull)
  videoMedia   Media?   @relation("HeroVideoMedia", fields: [videoMediaId], references: [id], onDelete: SetNull)

  @@index([active, displayOrder])
}

model HomepageSection {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?  @db.Text
  imageId     String?
  enabled     Boolean  @default(true)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  image       Media?   @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([enabled, displayOrder])
}

model Creator {
  id        String    @id @default(cuid())
  name      String
  role      String
  bio       String?
  image     String?
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Service {
  id        String          @id @default(cuid())
  name      String          @unique
  createdAt DateTime        @default(now())
  projects  Project[]
}

model Project {
  id               String          @id @default(cuid())
  title            String
  brief            String
  goal             String?
  audience         String?
  deliverables     String?
  references       String?
  deadline         DateTime?
  budget           String?
  status           ProjectStatus   @default(BRIEF_SUBMITTED)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  clientId         String
  creatorId        String?
  serviceId        String
  client           Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator          Creator?        @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  service          Service         @relation(fields: [serviceId], references: [id])
  messages         ProjectMessage[]
  activities       ProjectActivity[]
  deliveries       Delivery[]
  revisions        RevisionRequest[]
  review           ProjectReview?
}

model ProjectMessage {
  id        String   @id @default(cuid())
  fromRole  String
  text      String
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectActivity {
  id        String   @id @default(cuid())
  type      String
  text      String
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Delivery {
  id          String   @id @default(cuid())
  version     Int
  notes       String
  link        String?
  submittedAt DateTime @default(now())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([projectId, version])
}

model RevisionRequest {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectReview {
  id        String   @id @default(cuid())
  rating    Int
  text      String
  createdAt DateTime @default(now())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}


model EventOrganizer {
  id           String   @id @default(cuid())
  name         String
  contact      String?  @db.Text
  internalNotes String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  events       Event[]

  @@index([name])
}

model Event {
  id                     String      @id @default(cuid())
  name                   String
  slug                   String      @unique
  coverMediaId           String?
  artist                 String?
  venue                  String?
  city                   String?
  startsAt               DateTime
  description            String?     @db.Text
  publicTicketPrice      Decimal     @db.Decimal(12, 2)
  promoterDiscountPercent Decimal     @db.Decimal(5, 2)
  totalInventory         Int         @default(0)
  status                 EventStatus @default(DRAFT)
  internalNotes          String?     @db.Text
  organizerId            String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  coverMedia             Media?      @relation("EventCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  organizer              EventOrganizer? @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  applications           PromoterApplication[]
  promoterEvents         PromoterEvent[]
  gallery                 EventGalleryMedia[]

  @@index([status, startsAt])
  @@index([organizerId])
  @@index([city])
}

model EventGalleryMedia {
  id        String   @id @default(cuid())
  eventId   String
  mediaId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media Media @relation("EventGalleryMedia", fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([eventId, mediaId])
  @@index([eventId, sortOrder])
  @@index([mediaId])
}

model Promoter {
  id                    String         @id @default(cuid())
  userId                String         @unique
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  city                  String?
  address               String?        @db.Text
  experience            String?        @db.Text
  previousEventPromotion String?       @db.Text
  salesExperience       String?        @db.Text
  approximateAudience   Int?
  notes                 String?        @db.Text
  status                PromoterStatus @default(PENDING)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user                  User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  socialAccounts        PromoterSocialAccount[]
  applications          PromoterApplication[]
  events                PromoterEvent[]

  @@index([status])
  @@index([email])
}

model PromoterSocialAccount {
  id            String         @id @default(cuid())
  promoterId    String
  platform      SocialPlatform
  profileUrl    String?        @db.Text
  username      String?
  followerCount Int?
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  promoter      Promoter       @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@index([promoterId, platform])
}

model PromoterApplication {
  id              String                    @id @default(cuid())
  promoterId      String
  eventId         String
  status          PromoterApplicationStatus @default(PENDING)
  rejectReason    String?                   @db.Text
  adminNotes      String?                   @db.Text
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  reviewedAt      DateTime?
  reviewedByUserId String?

  promoter        Promoter                  @relation(fields: [promoterId], references: [id], onDelete: Restrict)
  event           Event                     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  reviewedBy      User?                     @relation("PromoterApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([promoterId, eventId])
  @@index([eventId, status])
  @@index([promoterId, status])
  @@index([reviewedByUserId])
}

model PromoterEvent {
  promoterId                String               
  eventId                   String               
  status                    PromoterEventStatus @default(ACTIVE)
  allocation                Int                  @default(0)
  promoterDiscountPercent   Decimal              @db.Decimal(5, 2)
  promoterPrice             Decimal              @db.Decimal(12, 2)
  soldQuantity              Int                  @default(0)
  remainingQuantity         Int                  @default(0)
  joinedAt                  DateTime             @default(now())
  notes                     String?              @db.Text
  updatedAt                 DateTime             @updatedAt

  promoter                  Promoter             @relation(fields: [promoterId], references: [id], onDelete: Restrict)
  event                     Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([promoterId, eventId])
  @@index([eventId, status])
  @@index([promoterId, status])
}
