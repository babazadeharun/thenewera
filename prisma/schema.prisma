model SalesDeal {
  id                 String          @id @default(cuid())
  title              String
  contactName        String?
  email              String?
  phone              String?
  source             String?
  stage              SalesDealStage  @default(NEW)
  priority           SalesPriority   @default(NORMAL)
  budget             Decimal?        @db.Decimal(14, 2)
  value              Decimal?        @db.Decimal(14, 2)
  probability        Int             @default(20)
  expectedCloseDate  DateTime?
  nextFollowUp       DateTime?
  lossReason         String?
  notes              String?         @db.Text
  proposalStatus     String?
  proposalValue      Decimal?        @db.Decimal(14, 2)
  proposalDate       DateTime?
  proposalSentAt     DateTime?
  proposalResponse   String?
  revisionStatus     String?
  clientId           String?
  serviceId          String?
  projectId          String?
  assignedUserId     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  client             Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  service            Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  project            Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedUser       User?           @relation("SalesDealAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
