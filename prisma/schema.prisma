generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  ADMIN
  CREATOR
  SUPER_ADMIN
  EVENTS_ADMIN
  EVENTS_FINANCE
  PROMOTER
}

enum EventStatus {
  DRAFT
  APPLICATION_OPEN
  ACTIVE
  SOLD_OUT
  COMPLETED
  CANCELLED
}

enum PromoterStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
  INACTIVE
}

enum PromoterApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum PromoterEventStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  FACEBOOK
  YOUTUBE
  TELEGRAM
  OTHER
}

enum VerificationChannel {
  EMAIL
  PHONE
}


enum SalesDealStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum SalesPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SalesActivityType {
  CALL
  EMAIL
  MEETING
  WHATSAPP
  FOLLOW_UP
  NOTE
  PROPOSAL
}

enum ProjectStatus {
  BRIEF_SUBMITTED
  REVIEWING
  APPROVED
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum MediaCategory {
  HERO
  CREATORS
  PORTFOLIO
  PORTFOLIO_VIDEO
  PORTFOLIO_DESIGN
  PARTNER_LOGO
  CLIENTS
  SERVICES
  BLOG
  GENERAL
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum FinanceTransactionStatus {
  POSTED
  VOID
  REVERSED
}

enum FinanceAccountType {
  BANK
  CASH
  CARD
  OTHER
}

enum FinanceAccountStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  ONLINE_PAYMENT
  OTHER
}

enum PayableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                           String                @id @default(cuid())
  email                        String?               @unique
  phone                        String?               @unique
  passwordHash                 String
  verifiedAt                   DateTime?
  role                         UserRole              @default(CLIENT)
  clientId                     String?               @unique
  client                       Client?               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessions                     Session[]
  verificationCodes            VerificationCode[]
  promoter                     Promoter?
  reviewedPromoterApplications PromoterApplication[] @relation("PromoterApplicationReviewer")
  eventAuditLogs               EventAuditLog[]       @relation("EventAuditActor")
  promoterPayments             PromoterPayment[]     @relation("PromoterPaymentRecorder")
  ledgerEntries                PromoterLedgerEntry[] @relation("LedgerEntryActor")
  assignedSalesDeals           SalesDeal[]           @relation("SalesDealAssignee")
  salesActivities              SalesActivity[]       @relation("SalesActivityCreator")
  financeTransactions          FinanceTransaction[]  @relation("FinanceTransactionCreator")
  financeInvoices              Invoice[]             @relation("InvoiceCreator")
  financePayments              FinancePayment[]      @relation("FinancePaymentCreator")
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id          String    @id @default(cuid())
  email       String?   @unique
  phone       String?   @unique
  firstName   String
  lastName    String
  company     String?
  jobTitle    String?
  industry    String?
  companySize String?
  country     String?
  website     String?
  createdAt   DateTime  @default(now())
  projects    Project[]
  user        User?
  salesDeals  SalesDeal[]
  salesActivities SalesActivity[]
  financeInvoices Invoice[]
  financeTransactions FinanceTransaction[]
  financePayments FinancePayment[]
}

model VerificationCode {
  id         String              @id @default(cuid())
  identifier String
  channel    VerificationChannel
  codeHash   String
  expiresAt  DateTime
  usedAt     DateTime?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, channel, createdAt])
  @@index([userId, createdAt])
}

model SiteSetting {
  id                 String   @id
  heroImage          String?  @db.Text
  siteName           String?  @db.Text
  logoMediaId        String?
  faviconMediaId     String?
  seoTitle           String?  @db.Text
  seoDescription     String?  @db.Text
  socialImageMediaId String?
  contactEmail       String?
  contactPhone       String?
  address            String?  @db.Text
  socialLinks        String?  @db.Text
  maintenanceMode    Boolean  @default(false)
  logoMedia          Media?   @relation("SiteLogoMedia", fields: [logoMediaId], references: [id], onDelete: SetNull)
  faviconMedia       Media?   @relation("SiteFaviconMedia", fields: [faviconMediaId], references: [id], onDelete: SetNull)
  socialImageMedia   Media?   @relation("SiteSocialImageMedia", fields: [socialImageMediaId], references: [id], onDelete: SetNull)
  updatedAt          DateTime @updatedAt
}

model Media {
  id                String              @id @default(cuid())
  filename          String
  originalName      String
  mimeType          String
  size              Int
  width             Int?
  height            Int?
  url               String              @db.Text
  storageKey        String?
  category          MediaCategory       @default(GENERAL)
  alt               String?             @db.Text
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  desktopHeros      Hero[]              @relation("HeroDesktopMedia")
  mobileHeros       Hero[]              @relation("HeroMobileMedia")
  videoHeros        Hero[]              @relation("HeroVideoMedia")
  homepageSections  HomepageSection[]
  siteLogos         SiteSetting[]       @relation("SiteLogoMedia")
  siteFavicons      SiteSetting[]       @relation("SiteFaviconMedia")
  siteSocialImages  SiteSetting[]       @relation("SiteSocialImageMedia")
  eventCoverMedia   Event[]             @relation("EventCoverMedia")
  eventGalleryMedia EventGalleryMedia[] @relation("EventGalleryMedia")

  @@index([category])
  @@index([createdAt])
}

model Hero {
  id             String   @id @default(cuid())
  title          String
  description    String?  @db.Text
  ctaText        String?
  ctaUrl         String?
  overlay        String?
  desktopMediaId String?
  mobileMediaId  String?
  videoMediaId   String?
  active         Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  desktopMedia   Media?   @relation("HeroDesktopMedia", fields: [desktopMediaId], references: [id], onDelete: SetNull)
  mobileMedia    Media?   @relation("HeroMobileMedia", fields: [mobileMediaId], references: [id], onDelete: SetNull)
  videoMedia     Media?   @relation("HeroVideoMedia", fields: [videoMediaId], references: [id], onDelete: SetNull)

  @@index([active, displayOrder])
}

model HomepageSection {
  id           String   @id @default(cuid())
  key          String   @unique
  title        String
  description  String?  @db.Text
  imageId      String?
  enabled      Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  image        Media?   @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([enabled, displayOrder])
}

model Creator {
  id        String    @id @default(cuid())
  name      String
  role      String
  bio       String?
  image     String?
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Service {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  projects  Project[]
  salesDeals SalesDeal[]
}

model Project {
  id           String            @id @default(cuid())
  title        String
  brief        String
  goal         String?
  audience     String?
  deliverables String?
  references   String?
  deadline     DateTime?
  budget       String?
  status       ProjectStatus     @default(BRIEF_SUBMITTED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  clientId     String
  creatorId    String?
  serviceId    String
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator      Creator?          @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  service      Service           @relation(fields: [serviceId], references: [id])
  messages     ProjectMessage[]
  activities   ProjectActivity[]
  deliveries   Delivery[]
  revisions    RevisionRequest[]
  review       ProjectReview?
  salesDeals   SalesDeal[]
  salesActivities SalesActivity[]
  financeInvoices Invoice[]
  financeTransactions FinanceTransaction[]
  financePayables FinancePayable[]
}

model ProjectMessage {
  id        String   @id @default(cuid())
  fromRole  String
  text      String
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectActivity {
  id        String   @id @default(cuid())
  type      String
  text      String
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Delivery {
  id          String   @id @default(cuid())
  version     Int
  notes       String
  link        String?
  submittedAt DateTime @default(now())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
}

model RevisionRequest {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectReview {
  id        String   @id @default(cuid())
  rating    Int
  text      String
  createdAt DateTime @default(now())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum TicketStatus {
  AVAILABLE
  ALLOCATED
  SOLD
  RETURNED
  CANCELLED
}

enum PromoterPaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  ALLOCATE
  RELEASE
  SALE
  PAYMENT
  LOGIN
  SECURITY
}

model EventOrganizer {
  id            String   @id @default(cuid())
  name          String
  contact       String?  @db.Text
  internalNotes String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  events        Event[]

  @@index([name])
}

model Event {
  id                      String      @id @default(cuid())
  name                    String
  slug                    String      @unique
  coverMediaId            String?
  artist                  String?
  venue                   String?
  city                    String?
  startsAt                DateTime
  description             String?     @db.Text
  publicTicketPrice       Decimal     @db.Decimal(12, 2)
  promoterDiscountPercent Decimal     @db.Decimal(5, 2)
  totalInventory          Int         @default(0)
  status                  EventStatus @default(DRAFT)
  internalNotes           String?     @db.Text
  isPublic                Boolean     @default(false)
  externalSource          String?
  externalId              String?
  externalUrl             String?     @db.Text
  externalPosterUrl       String?     @db.Text
  externalCategory        String?
  externalIngestedAt      DateTime?
  lastExternalSyncAt      DateTime?
  organizerId             String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  coverMedia        Media?                @relation("EventCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  organizer         EventOrganizer?       @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  applications      PromoterApplication[]
  promoterEvents    PromoterEvent[]
  gallery           EventGalleryMedia[]
  tickets           Ticket[]
  ticketAllocations TicketAllocation[]
  ticketSales       TicketSale[]
  promoterPayments  PromoterPayment[]
  ledgerEntries     PromoterLedgerEntry[]
  auditLogs         EventAuditLog[]

  @@index([status, startsAt])
  @@index([organizerId])
  @@index([city])
}

model EventGalleryMedia {
  id        String   @id @default(cuid())
  eventId   String
  mediaId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media Media @relation("EventGalleryMedia", fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([eventId, mediaId])
  @@index([eventId, sortOrder])
  @@index([mediaId])
}

model Promoter {
  id                     String         @id @default(cuid())
  userId                 String         @unique
  firstName              String
  lastName               String
  email                  String?
  phone                  String?
  city                   String?
  address                String?        @db.Text
  experience             String?        @db.Text
  previousEventPromotion String?        @db.Text
  salesExperience        String?        @db.Text
  approximateAudience    Int?
  notes                  String?        @db.Text
  status                 PromoterStatus @default(PENDING)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  user              User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  socialAccounts    PromoterSocialAccount[]
  applications      PromoterApplication[]
  events            PromoterEvent[]
  ticketAllocations TicketAllocation[]
  ticketSales       TicketSale[]
  payments          PromoterPayment[]
  ledgerEntries     PromoterLedgerEntry[]
  auditLogs         EventAuditLog[]

  @@index([status])
  @@index([email])
}

model PromoterSocialAccount {
  id            String         @id @default(cuid())
  promoterId    String
  platform      SocialPlatform
  profileUrl    String?        @db.Text
  username      String?
  followerCount Int?
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  promoter Promoter @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@index([promoterId, platform])
}

model PromoterApplication {
  id               String                    @id @default(cuid())
  promoterId       String
  eventId          String
  status           PromoterApplicationStatus @default(PENDING)
  rejectReason     String?                   @db.Text
  adminNotes       String?                   @db.Text
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  reviewedAt       DateTime?
  reviewedByUserId String?

  promoter   Promoter @relation(fields: [promoterId], references: [id], onDelete: Restrict)
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  reviewedBy User?    @relation("PromoterApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([promoterId, eventId])
  @@index([eventId, status])
  @@index([promoterId, status])
  @@index([reviewedByUserId])
}

model Ticket {
  id           String       @id @default(cuid())
  eventId      String
  ticketNumber String       @unique
  status       TicketStatus @default(AVAILABLE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  allocations TicketAllocation[]
  sale        TicketSale?

  @@index([eventId, status])
  @@index([eventId, ticketNumber])
}

model TicketAllocation {
  id                      String    @id @default(cuid())
  ticketId                String
  promoterId              String
  eventId                 String
  promoterPrice           Decimal   @db.Decimal(12, 2)
  promoterDiscountPercent Decimal   @db.Decimal(5, 2)
  allocatedAt             DateTime  @default(now())
  releasedAt              DateTime?

  ticket   Ticket      @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  sale     TicketSale?
  promoter Promoter    @relation(fields: [promoterId], references: [id], onDelete: Restrict)
  event    Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([ticketId, releasedAt])
  @@index([promoterId, eventId, releasedAt])
  @@index([eventId, releasedAt])
}

model TicketSale {
  id              String   @id @default(cuid())
  ticketId        String   @unique
  allocationId    String   @unique
  promoterId      String
  eventId         String
  promoterPrice   Decimal  @db.Decimal(12, 2)
  actualSalePrice Decimal  @db.Decimal(12, 2)
  margin          Decimal  @db.Decimal(12, 2)
  soldAt          DateTime @default(now())
  customerName    String?  @db.Text
  customerPhone   String?  @db.Text
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ticket     Ticket           @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  allocation TicketAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  promoter   Promoter         @relation(fields: [promoterId], references: [id], onDelete: Restrict)
  event      Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([promoterId, soldAt])
  @@index([eventId, soldAt])
  @@index([allocationId])
}

model PromoterPayment {
  id               String                @id @default(cuid())
  promoterId       String
  eventId          String?
  amount           Decimal               @db.Decimal(12, 2)
  method           PromoterPaymentMethod
  reference        String?               @db.Text
  paidAt           DateTime              @default(now())
  notes            String?               @db.Text
  recordedByUserId String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  promoter    Promoter             @relation(fields: [promoterId], references: [id], onDelete: Restrict)
  event       Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  recordedBy  User                 @relation("PromoterPaymentRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  ledgerEntry PromoterLedgerEntry?

  @@index([promoterId, paidAt])
  @@index([eventId, paidAt])
}

model PromoterLedgerEntry {
  id          String          @id @default(cuid())
  promoterId  String
  eventId     String?
  type        LedgerEntryType
  amount      Decimal         @db.Decimal(12, 2)
  description String          @db.Text
  sourceType  String
  sourceId    String
  paymentId   String?         @unique
  actorUserId String?
  createdAt   DateTime        @default(now())

  promoter Promoter         @relation(fields: [promoterId], references: [id], onDelete: Restrict)
  event    Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  payment  PromoterPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  actor    User?            @relation("LedgerEntryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([promoterId, createdAt])
  @@index([eventId, createdAt])
  @@index([sourceType, sourceId])
}

model EventAuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entityType  String
  entityId    String?
  actorUserId String?
  promoterId  String?
  eventId     String?
  ipAddress   String?
  userAgent   String?     @db.Text
  metadata    String?     @db.Text
  createdAt   DateTime    @default(now())

  actor    User?     @relation("EventAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  promoter Promoter? @relation(fields: [promoterId], references: [id], onDelete: SetNull)
  event    Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([eventId, createdAt])
  @@index([promoterId, createdAt])
}

model PromoterEvent {
  promoterId              String
  eventId                 String
  status                  PromoterEventStatus @default(ACTIVE)
  allocation              Int                 @default(0)
  promoterDiscountPercent Decimal             @db.Decimal(5, 2)
  promoterPrice           Decimal             @db.Decimal(12, 2)
  soldQuantity            Int                 @default(0)
  remainingQuantity       Int                 @default(0)
  joinedAt                DateTime            @default(now())
  notes                   String?             @db.Text
  updatedAt               DateTime            @updatedAt

  promoter Promoter @relation(fields: [promoterId], references: [id], onDelete: Restrict)
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([promoterId, eventId])
  @@index([eventId, status])
  @@index([promoterId, status])
}

model SalesDeal {
  id                 String          @id @default(cuid())
  title              String
  contactName        String?
  email              String?
  phone              String?
  source             String?
  stage              SalesDealStage  @default(NEW)
  priority           SalesPriority   @default(NORMAL)
  budget             Decimal?        @db.Decimal(14, 2)
  value              Decimal?        @db.Decimal(14, 2)
  probability        Int             @default(20)
  expectedCloseDate  DateTime?
  nextFollowUp       DateTime?
  lossReason         String?
  notes              String?         @db.Text
  proposalStatus     String?
  proposalValue      Decimal?        @db.Decimal(14, 2)
  proposalDate       DateTime?
  proposalSentAt     DateTime?
  proposalResponse   String?
  revisionStatus     String?
  clientId           String?
  serviceId          String?
  projectId          String?
  assignedUserId     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  client             Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  service            Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  project            Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedUser       User?           @relation("SalesDealAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  activities         SalesActivity[]

  @@index([stage, updatedAt])
  @@index([clientId])
  @@index([serviceId])
  @@index([assignedUserId])
  @@index([nextFollowUp])
}

model SalesActivity {
  id               String            @id @default(cuid())
  type             SalesActivityType
  text             String            @db.Text
  dueAt            DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  dealId           String
  clientId         String?
  projectId        String?
  createdByUserId  String?
  deal             SalesDeal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUser    User?             @relation("SalesActivityCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([dealId, createdAt])
  @@index([dueAt, completedAt])
  @@index([clientId])
}

model FinanceAccount {
  id             String                 @id @default(cuid())
  name           String
  type           FinanceAccountType     @default(BANK)
  openingBalance Decimal                @default(0) @db.Decimal(14, 2)
  currency       String                 @default("AZN")
  status         FinanceAccountStatus   @default(ACTIVE)
  notes          String?                @db.Text
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  transactions   FinanceTransaction[] @relation("FinanceTransactionAccount")
  incomingTransfers FinanceTransaction[] @relation("FinanceTransactionToAccount")

  @@index([status])
}

model Vendor {
  id           String       @id @default(cuid())
  name         String
  company      String?
  phone        String?
  email        String?
  taxId        String?
  address      String?      @db.Text
  notes        String?      @db.Text
  status       VendorStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  transactions FinanceTransaction[]
  payables     FinancePayable[]

  @@index([name])
  @@index([status])
}

model FinanceTransaction {
  id              String                    @id @default(cuid())
  date            DateTime
  amount          Decimal                   @db.Decimal(14, 2)
  type            FinanceTransactionType
  status          FinanceTransactionStatus  @default(POSTED)
  category        String
  description     String                    @db.Text
  accountId       String?
  toAccountId     String?
  clientId        String?
  vendorId        String?
  projectId       String?
  invoiceId       String?
  paymentMethod   PaymentMethod?
  reference       String?
  notes           String?                   @db.Text
  createdById     String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  account         FinanceAccount?           @relation("FinanceTransactionAccount", fields: [accountId], references: [id], onDelete: SetNull)
  toAccount       FinanceAccount?           @relation("FinanceTransactionToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  client          Client?                   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  vendor          Vendor?                   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  project         Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoice         Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy       User?                     @relation("FinanceTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date, type, status])
  @@index([accountId, date])
  @@index([toAccountId, date])
  @@index([clientId])
  @@index([vendorId])
  @@index([projectId])
  @@index([invoiceId])
}

model Invoice {
  id              String          @id @default(cuid())
  number          String          @unique
  clientId        String
  projectId       String?
  issueDate       DateTime
  dueDate         DateTime
  subtotal        Decimal         @db.Decimal(14, 2)
  tax             Decimal         @default(0) @db.Decimal(14, 2)
  discount        Decimal         @default(0) @db.Decimal(14, 2)
  total           Decimal         @db.Decimal(14, 2)
  paidAmount      Decimal         @default(0) @db.Decimal(14, 2)
  currency        String          @default("AZN")
  status          InvoiceStatus   @default(DRAFT)
  notes           String?         @db.Text
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy       User?           @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items           InvoiceItem[]
  payments        FinancePayment[]
  transactions    FinanceTransaction[]

  @@index([clientId, dueDate])
  @@index([projectId])
  @@index([status, dueDate])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  serviceName String?
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(14, 2)
  discount    Decimal  @default(0) @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model FinancePayment {
  id             String          @id @default(cuid())
  invoiceId      String
  amount         Decimal         @db.Decimal(14, 2)
  date           DateTime
  method         PaymentMethod
  accountId      String?
  reference      String?
  notes          String?         @db.Text
  createdById    String?
  createdAt      DateTime        @default(now())
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  clientId       String?
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("FinancePaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([invoiceId, date])
  @@index([clientId])
}

model FinancePayable {
  id           String        @id @default(cuid())
  vendorId     String
  description  String
  amount       Decimal       @db.Decimal(14, 2)
  dueDate      DateTime
  paidAmount   Decimal       @default(0) @db.Decimal(14, 2)
  status       PayableStatus @default(OPEN)
  projectId    String?
  category     String
  notes        String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  vendor       Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([vendorId, dueDate])
  @@index([status, dueDate])
  @@index([projectId])
}
