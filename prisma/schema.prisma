  @@index([invoiceId])
}

model FinancePayment {
  id             String          @id @default(cuid())
  invoiceId      String
  amount         Decimal         @db.Decimal(14, 2)
  date           DateTime
  method         PaymentMethod
  accountId      String?
  reference      String?
  notes          String?         @db.Text
  createdById    String?
  createdAt      DateTime        @default(now())
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  clientId       String?
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("FinancePaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([invoiceId, date])
  @@index([clientId])
}

model FinancePayable {
  id           String        @id @default(cuid())
  vendorId     String
  description  String
  amount       Decimal       @db.Decimal(14, 2)
  dueDate      DateTime
  paidAmount   Decimal       @default(0) @db.Decimal(14, 2)
  status       PayableStatus @default(OPEN)
  projectId    String?
  category     String
  notes        String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  vendor       Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([vendorId, dueDate])
  @@index([status, dueDate])
  @@index([projectId])
}


enum EmailDirection {
  INBOUND
  OUTBOUND
}

model MailDraft {
  id          String              @id @default(cuid())
  createdById String
  clientId    String?
  to          String              @db.Text
  cc          String?             @db.Text
  bcc         String?             @db.Text
  subject     String?             @db.Text
  body        String              @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  client      Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  attachments MailDraftAttachment[]

  @@index([createdById, updatedAt])
  @@index([clientId, updatedAt])
}

model MailDraftAttachment {
  id          String   @id @default(cuid())
  draftId     String
  filename    String
  mimeType    String
  sizeBytes   Int
  data        Bytes
  createdAt   DateTime @default(now())
  draft       MailDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

model MailMetadata {
  id         String   @id @default(cuid())
  folder     String
  uid        Int
  read       Boolean  @default(false)
  starred    Boolean  @default(false)
  messageId  String?
  clientId   String?
  updatedAt  DateTime @updatedAt
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([folder, uid])
  @@index([clientId, updatedAt])
  @@index([userId, updatedAt])
}

model EmailCommunication {
  id          String        @id @default(cuid())
  messageId   String        @unique
  clientId    String
  direction   EmailDirection
  subject     String?       @db.Text
  fromAddress String        @db.Text
  toAddress   String        @db.Text
  sentAt      DateTime
  createdAt   DateTime      @default(now())
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, sentAt])
  @@index([direction, sentAt])
}

