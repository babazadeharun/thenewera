}

model FinanceAccount {
  id             String                 @id @default(cuid())
  name           String
  type           FinanceAccountType     @default(BANK)
  openingBalance Decimal                @default(0) @db.Decimal(14, 2)
  currency       String                 @default("AZN")
  status         FinanceAccountStatus   @default(ACTIVE)
  notes          String?                @db.Text
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  transactions   FinanceTransaction[] @relation("FinanceTransactionAccount")
  incomingTransfers FinanceTransaction[] @relation("FinanceTransactionToAccount")

  @@index([status])
}

model Vendor {
  id           String       @id @default(cuid())
  name         String
  company      String?
  phone        String?
  email        String?
  taxId        String?
  address      String?      @db.Text
  notes        String?      @db.Text
  status       VendorStatus @default(ACTIVE)
